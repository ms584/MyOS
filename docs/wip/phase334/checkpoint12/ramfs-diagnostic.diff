+/* Isolated Phase33.4 diagnostic only: discard whole single-line NetLog
+ * receive-byte events79/80 from n.json; preserve outgoing bytes, TLS events,
+ * request/response headers and every other event. Production source unchanged. */
+static unsigned diagnostic_netlog_type(const void *buffer,size_t length)
+{
+    const char *bytes=buffer;size_t end=length;
+    while(end&&(bytes[end-1]=='\n'||bytes[end-1]=='\r'||bytes[end-1]==','))--end;
+    if(end<10||bytes[end-1]!='}')return 0;
+    size_t first=end-1;while(first&&bytes[first-1]>='0'&&bytes[first-1]<='9')--first;
+    if(first<7||first==end-1)return 0;static const char prefix[]="\"type\":";
+    for(unsigned i=0;i<7;++i)if(bytes[first-7+i]!=prefix[i])return 0;
+    unsigned type=0;for(size_t i=first;i<end-1;++i)type=type*10+(unsigned)(bytes[i]-'0');
+    return type;
+}
+static const char *diagnostic_field(const char *bytes,size_t n,const char *field,size_t m)
+{
+    for(size_t i=0;i+m<=n;++i){bool same=true;
+        for(size_t j=0;j<m;++j)if(bytes[i+j]!=field[j]){same=false;break;}
+        if(same)return bytes+i+m;}
+    return 0;
+}
+static char *diagnostic_number(char *out,unsigned value)
+{
+    char reverse[10];unsigned n=0;do{reverse[n++]=(char)('0'+value%10);value/=10;}while(value);
+    while(n)*out++=reverse[--n];return out;
+}
+static void diagnostic_live_status(const char *bytes,size_t n)
+{
+    unsigned type=diagnostic_netlog_type(bytes,n);bool media=false;unsigned status=0;
+    if(type==123){static const char host[]=".googlevideo.com/videoplayback";
+        media=diagnostic_field(bytes,n,host,sizeof(host)-1)!=0;if(!media)return;}
+    else if(type==223){static const char http[]="HTTP/1.1 ";
+        const char *code=diagnostic_field(bytes,n,http,sizeof(http)-1);if(!code||code+3>bytes+n)return;
+        for(unsigned i=0;i<3;++i){if(code[i]<'0'||code[i]>'9')return;status=status*10+(unsigned)(code[i]-'0');}}
+    else return;
+    static const char source[]="\"source\":{\"id\":";
+    const char *id=diagnostic_field(bytes,n,source,sizeof(source)-1);if(!id)return;
+    unsigned value=0;while(id<bytes+n&&*id>='0'&&*id<='9')value=value*10+(unsigned)(*id++-'0');
+    char line[128],*end=line;const char *prefix=media?"DIAGNOSTIC_NATIVE_MEDIA_JOB source=":"DIAGNOSTIC_NATIVE_HTTP source=";
+    while(*prefix)*end++=*prefix++;end=diagnostic_number(end,value);
+    if(media){static const char method[]="\"method\":\"POST\"";
+        const char *label=diagnostic_field(bytes,n,method,sizeof(method)-1)?" method=POST":" method=OTHER";
+        while(*label)*end++=*label++;}
+    else{const char *label=" status=";while(*label)*end++=*label++;end=diagnostic_number(end,status);}
+    *end++='\n';for(char *at=line;at<end;++at)serial_put(*at);
+}
+static bool diagnostic_netlog_receive(const void *buffer,size_t length)
+{unsigned type=diagnostic_netlog_type(buffer,length);return type==79||type==80||type==91||type==135||type==136;}
+static char *diagnostic_netlog_line;
+static size_t diagnostic_netlog_pending;
+static int diagnostic_netlog_flush(struct node *node,struct fs_handle *file)
+{
+    size_t n=diagnostic_netlog_pending;if(!n)return 0;
+    diagnostic_live_status(diagnostic_netlog_line,n);
+    size_t first=0,last=0;
+    if(diagnostic_netlog_receive(diagnostic_netlog_line,n)){
+        static const char field[]="\"bytes\":\"";
+        for(size_t i=0;i+sizeof(field)-1<n;++i){
+            bool equal_field=true;for(unsigned j=0;j<sizeof(field)-1;++j)
+                if(diagnostic_netlog_line[i+j]!=field[j]){equal_field=false;break;}
+            if(equal_field){first=i+sizeof(field)-1;last=first;
+                while(last<n&&diagnostic_netlog_line[last]!='\"')++last;
+                if(last==n){first=0;last=0;}break;}
+        }
+    }
+    size_t prefix=first?first:n;
+    int64_t rc=shm_write(node->shared,file->offset,diagnostic_netlog_line,prefix);
+    if(rc!=(int64_t)prefix)return rc<0?(int)rc:-5;file->offset+=prefix;
+    if(first){size_t suffix=n-last;rc=shm_write(node->shared,file->offset,diagnostic_netlog_line+last,suffix);
+        if(rc!=(int64_t)suffix)return rc<0?(int)rc:-5;file->offset+=suffix;}
+    node->size=node->shared->size;
+    diagnostic_netlog_pending=0;return 0;
+}
+static void diagnostic_netlog_finish(struct node *node,struct fs_handle *file)
+{
+    diagnostic_netlog_flush(node,file);kfree(diagnostic_netlog_line);
+    diagnostic_netlog_line=0;diagnostic_netlog_pending=0;
+}
+static int64_t diagnostic_netlog_write(struct node *node,struct fs_handle *file,const void *buffer,size_t length)
+{
+    const char *bytes=buffer;
+    if(!diagnostic_netlog_line){diagnostic_netlog_line=kmalloc(256u*1024u);if(!diagnostic_netlog_line)return -12;}
+    for(size_t i=0;i<length;++i){
+        if(diagnostic_netlog_pending==256u*1024u)return -28;
+        diagnostic_netlog_line[diagnostic_netlog_pending++]=bytes[i];
+        if(bytes[i]=='\n'){int rc=diagnostic_netlog_flush(node,file);if(rc)return rc;}
+    }
+    return (int64_t)length;
+}
