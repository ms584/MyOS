+/* Isolated diagnostic: decode only native TLS NetLog plaintext framing.
+ * No media sample decoding, credentials, URLs or arbitrary payload output. */
+static int diagnostic_b64_digit(unsigned char c)
+{
+    if(c>='A'&&c<='Z')return c-'A';if(c>='a'&&c<='z')return c-'a'+26;
+    if(c>='0'&&c<='9')return c-'0'+52;return c=='+'?62:c=='/'?63:-1;
+}
+static bool diagnostic_ump_uint(const unsigned char *p,size_t n,size_t *at,unsigned *value)
+{
+    if(*at>=n)return false;unsigned b=p[(*at)++],size=1;
+    while(size<=5&&(b&(128u>>(size-1))))++size;
+    if(size>5||n-*at<size-1)return false;
+    unsigned v=size==5?0:b&((1u<<(8-size))-1u);
+    for(unsigned i=1;i<size;++i){unsigned shift=size==5?8*(i-1):8*(i-1)+(8-size);v|=(unsigned)p[(*at)++]<<shift;}
+    *value=v;return true;
+}
+static void diagnostic_ump_parts(const char *line,size_t n)
+{
+    if(diagnostic_netlog_type(line,n)!=80)return;
+    const char *b=diagnostic_field(line,n,"\"bytes\":\"",9);
+    const char *id=diagnostic_field(line,n,"\"source\":{\"id\":",15);
+    if(!b||!id)return;
+    unsigned source=0;while(id<line+n&&*id>='0'&&*id<='9')source=source*10+(unsigned)(*id++-'0');
+    unsigned char *plain=kmalloc(65536);if(!plain)return;size_t count=0;unsigned value=0,bits=0;
+    while(b<line+n&&*b!='"'&&*b!='='){
