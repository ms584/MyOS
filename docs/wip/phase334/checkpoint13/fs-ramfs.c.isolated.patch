+    }
+    const char *end=diagnostic_field((const char*)plain,count,"\r\n\r\n",4);
+    if(!end)goto done;size_t header=(size_t)(end-(const char*)plain);
+    if(!diagnostic_field((const char*)plain,header,"application/vnd.yt-ump",22))goto done;
+    bool chunked=diagnostic_field((const char*)plain,header,"chunked",7)!=0;
+    size_t at=header;unsigned char *body=plain+at;size_t available=count-at;
+    if(chunked){
+        size_t k=0;unsigned length=0,digits=0;
+        while(k<available&&body[k]!='\r'){
+            unsigned c=body[k++],d=c>='0'&&c<='9'?c-'0':c>='a'&&c<='f'?c-'a'+10:c>='A'&&c<='F'?c-'A'+10:99;
+            if(d>15||digits++==8)goto done;length=length*16+d;
+        }
+        if(!digits||k+2>available||body[k]!='\r'||body[k+1]!='\n')goto done;
+        body+=k+2;available-=k+2;if(available>length)available=length;
+    }
+    at=0;unsigned part=0,length=0;
+    for(unsigned i=0;i<32&&at<available;++i){
+        if(!diagnostic_ump_uint(body,available,&at,&part)||!diagnostic_ump_uint(body,available,&at,&length))break;
+        char out[128],*cursor=out;const char *label="DIAGNOSTIC_NATIVE_UMP tls-source=";
+        while(*label)*cursor++=*label++;cursor=diagnostic_number(cursor,source);
+        label=" part=";while(*label)*cursor++=*label++;cursor=diagnostic_number(cursor,part);
+        label=" declared-bytes=";while(*label)*cursor++=*label++;cursor=diagnostic_number(cursor,length);
+        label=" available-bytes=";while(*label)*cursor++=*label++;cursor=diagnostic_number(cursor,(unsigned)(available-at));
+        *cursor++='\n';for(char *x=out;x<cursor;++x)serial_put(*x);
+        if(length>available-at)break;at+=length;
+    }
+done:kfree(plain);
+}
