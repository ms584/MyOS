+static bool diagnostic_netlog_receive(const void *buffer,size_t length)
+{unsigned type=diagnostic_netlog_type(buffer,length);return type==79||type==80||type==91||type==135||type==136;}
+static char *diagnostic_netlog_line;
+static size_t diagnostic_netlog_pending;
+static int diagnostic_netlog_flush(struct node *node,struct fs_handle *file)
+{
+    size_t n=diagnostic_netlog_pending;if(!n)return 0;
+    diagnostic_live_status(diagnostic_netlog_line,n);
+    diagnostic_ump_parts(diagnostic_netlog_line,n);
+    size_t first=0,last=0;
+    if(diagnostic_netlog_receive(diagnostic_netlog_line,n)){
+        static const char field[]="\"bytes\":\"";
+        for(size_t i=0;i+sizeof(field)-1<n;++i){
+            bool equal_field=true;for(unsigned j=0;j<sizeof(field)-1;++j)
+                if(diagnostic_netlog_line[i+j]!=field[j]){equal_field=false;break;}
+            if(equal_field){first=i+sizeof(field)-1;last=first;
+                while(last<n&&diagnostic_netlog_line[last]!='\"')++last;
+                if(last==n){first=0;last=0;}break;}
+        }
+    }
