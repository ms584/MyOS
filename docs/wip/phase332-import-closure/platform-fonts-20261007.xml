<?xml version="1.0" encoding="UTF-8"?>
<!-- MyOS platform font configuration; real DejaVu 2.37 fonts, not an engine patch. -->
<familyset version="1">
  <family name="sans-serif">
    <font weight="400" style="normal" font_name="DejaVu Sans" postscript_name="DejaVuSans">DejaVuSans.ttf</font>
  </family>
  <family name="serif">
    <font weight="400" style="normal" font_name="DejaVu Serif" postscript_name="DejaVuSerif">DejaVuSerif.ttf</font>
  </family>
  <family name="monospace">
    <font weight="400" style="normal" font_name="DejaVu Sans Mono" postscript_name="DejaVuSansMono">DejaVuSansMono.ttf</font>
  </family>
  <alias name="dejavu sans" to="sans-serif"/>
  <alias name="dejavu serif" to="serif"/>
  <alias name="dejavu sans mono" to="monospace"/>
  <alias name="sans-serif-monospace" to="monospace"/>
  <alias name="fantasy" to="serif"/>
  <alias name="cursive" to="sans-serif"/>
</familyset>
